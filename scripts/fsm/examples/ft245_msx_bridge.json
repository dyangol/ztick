{
  "meta": {
    "name": "msx_ft245_bridge_3state",
    "description": "FSM de 3 estats (IDLE/WRITE/READ) amb port I/O 0x38"
  },
  "rom": {
    "size": 65536,
    "fill": 255
  },
  "address_layout": {
    "state_bits": [0, 1, 2],
    "input_signals": {
      "FT_RXF_L": 3,
      "FT_TXE": 4,
      "WR_L": 5,
      "RD_L": 6,
      "IORQ_L": 7,
      "msx_a0": 8,
      "msx_a1": 9,
      "msx_a2": 10,
      "msx_a3": 11,
      "msx_a4": 12,
      "msx_a5": 13,
      "msx_a6": 14,
      "msx_a7": 15
    }
  },
  "output_layout": {
    "next_state_bits": [0, 1, 2],
    "control_bits": {
      "FT_RD_L": 3,
      "FT_WR": 4,
      "DIR_L": 5,
      "EBUS_L": 6
    }
  },
  "states": {
    "IDLE": 0,
    "WRITE": 1,
    "READ": 2
  },
  "default": {
    "next": "IDLE",
    "controls": {
      "FT_RD_L": 1,
      "FT_WR": 0,
      "DIR_L": 1,
      "EBUS_L": 1
    }
  },
  "rules": [
    {
      "name": "s1_idle_to_write",
      "state": "IDLE",
      "when": "port==0x38 and IORQ_L==0 and FT_TXE==1 and WR_L==0",
      "next": "WRITE",
      "controls": {
        "FT_RD_L": 1,
        "FT_WR": 1,
        "DIR_L": 1,
        "EBUS_L": 0
      }
    },
    {
      "name": "s2_idle_to_read",
      "state": "IDLE",
      "when": "port==0x38 and IORQ_L==0 and RD_L==0 and FT_RXF_L==0",
      "next": "READ",
      "controls": {
        "FT_RD_L": 0,
        "FT_WR": 0,
        "DIR_L": 0,
        "EBUS_L": 0
      }
    },
    {
      "name": "write_to_idle",
      "state": "WRITE",
      "when": "1",
      "next": "IDLE",
      "controls": {
        "FT_RD_L": 1,
        "FT_WR": 0,
        "DIR_L": 1,
        "EBUS_L": 1
      }
    },
    {
      "name": "read_to_idle",
      "state": "READ",
      "when": "1",
      "next": "IDLE",
      "controls": {
        "FT_RD_L": 1,
        "FT_WR": 0,
        "DIR_L": 1,
        "EBUS_L": 1
      }
    }
  ]
}
